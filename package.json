{
  "name": "fuzzy-ch-wsn-web",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:animations",
    "build:animations": "esbuild web/animations.js --bundle --format=iife --target=es2020 --outfile=web/animations.bundle.js --minify",
    "build:css": "tailwindcss -i ./web/tailwind.input.css -o ./web/tailwind.css --minify"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "motion": "^14.14.0",
    "tailwindcss": "3.4.17"
  }
}
